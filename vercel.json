{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "src/server/**,src/lib/types.ts,src/lib/season-config.ts"
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh-players",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
