{
  "name": "college-gridiron-fan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:integration:local": "node --import tsx --import ./tests/integration/local-proxy.ts --test tests/integration/*.test.ts",
    "test:integration:hosted": "tsx scripts/test-hosted.ts",
    "test:edge": "tsx --test tests/edge/*.test.ts",
    "test:browser": "playwright test",
    "verify": "npm run lint && npm test && npm run build",
    "verify:release": "npm run verify && npm run test:browser && npm run test:integration:hosted",
    "lint": "eslint .",
    "optimize": "vite optimize",
    "preview": "vite preview",
    "refresh:projections": "tsx scripts/refresh-projections.ts",
    "refresh:players": "tsx scripts/refresh-players.ts",
    "refresh:schedules": "tsx scripts/refresh-schedules.ts",
    "refresh:live": "tsx scripts/refresh-live.ts",
    "refresh:gameday": "tsx scripts/refresh-gameday.ts",
    "notify:lineups": "tsx scripts/notify-lineups.ts",
    "audit:usage": "tsx scripts/audit-usage.ts",
    "measure:build": "tsx scripts/measure-build.ts"
  },
